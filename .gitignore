build/
__pycache__/
*.pyc
.claude/

# Persistence runtime substrate — state snapshots and append-only event logs regenerate per run.
# These ARE the organism's memory, but at this scale they are local-runtime artifacts, not source.
# The eval-artifact JSONs (run/artifacts/) point to these paths and are the load-bearing evidence
# tracked in git. To audit a snapshot, regenerate with `make test` or the persistence-self-test phase.
run/state/

# Routine wrapper manifests are emitted on every wrapper run. Cycle evidence copies live as flat
# tracked JSON artifacts under run/artifacts/organic-v0/.
run/artifacts/organic-v0/run_manifests/
